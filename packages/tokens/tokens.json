{
  "$meta": {
    "name": "Wyre Tracker Design Tokens",
    "basis": "Northstar Design Tokens v1.0 (prefix --ns-) married with the Wyre brand",
    "brand": { "purple": "#5C3592", "purpleBright": "#8134AF", "yellow": "#F9CF40", "yellowFavicon": "#FCD441" },
    "rule": "Components reference semantic aliases (--ns-color-*) only, never primitives."
  },
  "primitive": {
    "neutral": { "0": "#FFFFFF", "50": "#F8FAFC", "100": "#F1F5F9", "200": "#E2E8F0", "300": "#CBD5E1", "400": "#94A3B8", "500": "#64748B", "600": "#475569", "700": "#334155", "800": "#1E293B", "900": "#0F172A", "950": "#020617" },
    "purple":  { "50": "#F3EEFA", "100": "#E6DCF5", "200": "#CDB9EB", "300": "#AD8EDC", "400": "#8B62C9", "450": "#8134AF", "500": "#6F45AC", "600": "#5C3592", "700": "#4B2A78", "800": "#3A205E", "900": "#2A1745" },
    "yellow":  { "50": "#FFFBEA", "100": "#FEF3C2", "200": "#FDEA96", "300": "#FBE07A", "400": "#F9CF40", "500": "#E5B920", "600": "#C69A0E", "700": "#9A7708" },
    "blue":    { "50": "#EFF6FF", "100": "#DBEAFE", "200": "#BFDBFE", "300": "#93C5FD", "400": "#60A5FA", "500": "#3B82F6", "600": "#2563EB", "700": "#1D4ED8", "800": "#1E40AF", "900": "#1E3A8A" },
    "green":   { "50": "#ECFDF5", "100": "#D1FAE5", "200": "#A7F3D0", "500": "#10B981", "600": "#059669", "700": "#047857", "800": "#065F46" },
    "amber":   { "50": "#FFFBEB", "100": "#FEF3C7", "400": "#FBBF24", "500": "#F59E0B", "600": "#D97706", "700": "#B45309", "800": "#92400E" },
    "red":     { "50": "#FEF2F2", "100": "#FEE2E2", "400": "#F87171", "500": "#EF4444", "600": "#DC2626", "700": "#B91C1C", "800": "#991B1B" },

    "space":   { "0": "0px", "3xs": "4px", "2xs": "8px", "xs": "12px", "sm": "16px", "md": "24px", "lg": "32px", "xl": "48px", "2xl": "64px", "3xl": "96px" },
    "radius":  { "none": "0px", "small": "4px", "medium": "8px", "large": "12px", "full": "999px" },
    "font":    { "primary": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "reading": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif", "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace" },
    "weight":  { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
    "scale":   { "": "1" },
    "size":    { "display": "calc(2.25rem * var(--ns-scale))", "page": "calc(1.75rem * var(--ns-scale))", "heading": "calc(1.375rem * var(--ns-scale))", "subheading": "calc(1.125rem * var(--ns-scale))", "body-lg": "calc(1.0625rem * var(--ns-scale))", "body": "calc(1rem * var(--ns-scale))", "body-sm": "calc(0.875rem * var(--ns-scale))", "caption": "calc(0.8125rem * var(--ns-scale))", "label": "calc(0.75rem * var(--ns-scale))" },
    "lh":      { "display": "2.75rem", "page": "2.25rem", "heading": "1.875rem", "subheading": "1.625rem", "body-lg": "1.75rem", "body": "1.625rem", "body-sm": "1.375rem", "caption": "1.125rem", "label": "1rem" },
    "tracking":{ "tight": "-0.01em", "normal": "0", "label": "0.04em" },
    "duration":{ "fast": "120ms", "normal": "200ms", "slow": "320ms" },
    "easing":  { "standard": "cubic-bezier(0.2, 0, 0.2, 1)", "entrance": "cubic-bezier(0, 0, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" },
    "elevation": { "0": "none", "1": "0 1px 2px rgba(15,23,42,0.04)", "2": "0 4px 12px rgba(15,23,42,0.08)", "3": "0 12px 32px rgba(15,23,42,0.12)", "4": "0 20px 48px rgba(15,23,42,0.16)" },
    "border":  { "hairline": "1px", "strong": "2px" },
    "focus-ring": { "width": "2px", "offset": "2px" },
    "z":       { "base": "0", "sticky": "100", "dropdown": "1000", "overlay": "1100", "modal": "1200", "toast": "1300", "critical": "1400" },
    "opacity": { "disabled": "0.4", "scrim": "0.45" },
    "touch":   { "min": "44px" }
  },
  "semantic": {
    "light": {
      "canvas": "{neutral.50}", "bg-secondary": "{neutral.100}", "surface": "{neutral.0}", "surface-subtle": "{neutral.50}", "surface-hover": "{neutral.100}", "surface-selected": "{purple.50}", "overlay-scrim": "rgba(15,23,42,0.45)",
      "text-primary": "{neutral.900}", "text-secondary": "{neutral.600}", "text-tertiary": "{neutral.500}", "text-disabled": "{neutral.400}", "text-inverse": "{neutral.0}", "text-link": "{purple.700}",
      "border-subtle": "{neutral.100}", "border-default": "{neutral.200}", "border-strong": "{neutral.300}", "border-focus": "{purple.500}",
      "primary": "{purple.600}", "primary-hover": "{purple.700}", "primary-pressed": "{purple.800}", "primary-subtle": "{purple.50}", "on-primary": "{neutral.0}",
      "accent": "{yellow.400}", "accent-hover": "{yellow.500}", "accent-subtle": "{yellow.50}", "on-accent": "{neutral.900}",
      "success-fill": "{green.600}", "success-subtle": "{green.50}", "success-text": "{green.700}", "success-on": "{neutral.0}",
      "warning-fill": "{amber.600}", "warning-subtle": "{amber.50}", "warning-text": "{amber.700}", "warning-on": "{neutral.900}",
      "danger-fill": "{red.600}", "danger-subtle": "{red.50}", "danger-text": "{red.700}", "danger-on": "{neutral.0}",
      "info-fill": "{blue.600}", "info-subtle": "{blue.50}", "info-text": "{blue.700}", "info-on": "{neutral.0}",
      "brand-nav": "{purple.900}", "brand-nav-text": "{purple.100}", "brand-nav-active": "{purple.700}"
    },
    "dark": {
      "canvas": "#0C0A14", "bg-secondary": "#130F1F", "surface": "#191428", "surface-subtle": "#130F1F", "surface-hover": "#231B36", "surface-selected": "#2A1F42", "overlay-scrim": "rgba(2,6,23,0.65)",
      "text-primary": "#F1F5F9", "text-secondary": "#A39BB8", "text-tertiary": "#7A7290", "text-disabled": "#524A66", "text-inverse": "#0F172A", "text-link": "{purple.300}",
      "border-subtle": "#231B36", "border-default": "#2E2545", "border-strong": "#3E335A", "border-focus": "{purple.300}",
      "primary": "{purple.400}", "primary-hover": "{purple.300}", "primary-pressed": "{purple.200}", "primary-subtle": "#2A1F42", "on-primary": "#0C0A14",
      "accent": "{yellow.400}", "accent-hover": "{yellow.300}", "accent-subtle": "#2E2610", "on-accent": "#0C0A14",
      "success-fill": "#10B981", "success-subtle": "#0C2A22", "success-text": "#34D399", "success-on": "#0C0A14",
      "warning-fill": "#F59E0B", "warning-subtle": "#2A2008", "warning-text": "#FBBF24", "warning-on": "#0C0A14",
      "danger-fill": "#EF4444", "danger-subtle": "#2C1315", "danger-text": "#F87171", "danger-on": "#0C0A14",
      "info-fill": "#3B82F6", "info-subtle": "#16233F", "info-text": "#60A5FA", "info-on": "#0C0A14",
      "brand-nav": "#0C0A14", "brand-nav-text": "{purple.200}", "brand-nav-active": "{purple.700}"
    }
  },
  "darkElevation": { "1": "0 1px 2px rgba(0,0,0,0.4)", "2": "0 4px 12px rgba(0,0,0,0.5)", "3": "0 12px 32px rgba(0,0,0,0.6)", "4": "0 20px 48px rgba(0,0,0,0.7)" }
}
