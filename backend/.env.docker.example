# copy to .env.docker — never commit the real file
POSTGRES_DB=wyre_tracker
POSTGRES_USER=wyre_tracker
POSTGRES_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
# 1 = load the demo data set on first start (never on production data)
SEED_DEMO=0
# host ports
API_PORT=8000
DB_PORT=5433

# --- Uploads: DigitalOcean Spaces (leave SPACES_BUCKET empty to store on local disk) ---
SPACES_BUCKET=
SPACES_REGION=fra1
# SPACES_ENDPOINT defaults to https://<region>.digitaloceanspaces.com
SPACES_ENDPOINT=
SPACES_KEY=
SPACES_SECRET=
# seconds a signed download link stays valid
SPACES_URL_EXPIRY=900

# --- Alert email (Mailgun). Leave MAILGUN_API_KEY empty and the digest command reports without sending. ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.wyreng.com
MAILGUN_FROM=Wyre Tracker <postmaster@mg.wyreng.com>
# base URL used for links inside the email
APP_BASE_URL=http://localhost:5174

# --- Alert scheduler (runs inside the stack, not host cron) ---
ALERTS_INTERVAL_MINUTES=60
DIGEST_AT=07:30
# 1 to actually email the digest. Leave 0 while the demo accounts use placeholder addresses.
DIGEST_ENABLED=0
# optional: force every digest to one address while testing
DIGEST_TO=
