{
  "name": "Wyre Field",
  "short_name": "Wyre Field",
  "description": "Wyre Energy field app — visits, issues, photos, van stock",
  "id": "/field",
  "start_url": "/field",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F9FC",
  "theme_color": "#5C3592",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New issue", "url": "/field/issues/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log a visit", "url": "/field/visits/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
