# Wyre Tracker — production environment.
#
#   cp .env.prod.example .env      &&  edit .env      (compose reads .env from this directory)
#
# .env is gitignored and must stay that way. Nothing in here belongs in a commit, a brief, a README
# or a chat message. If a value leaks, rotate it rather than hoping.

# ── Database ────────────────────────────────────────────────────────────────────
# Paste the DigitalOcean cluster's connection string verbatim, INCLUDING ?sslmode=require —
# the cluster refuses plaintext connections and Django now honours that query parameter.
# Use the dedicated wyre_tracker user and database, not doadmin/defaultdb.
# If the password contains @ : / ? # it must be percent-encoded; DO's copy button does this for you.
DATABASE_URL=postgresql://wyre_tracker:PASSWORD@db-postgresql-nyc1-XXXXX.b.db.ondigitalocean.com:25060/wyre_tracker?sslmode=require

# ── Django ──────────────────────────────────────────────────────────────────────
# 50+ random characters, unique to production. Generate, don't invent:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated, no scheme, no port. Django rejects any Host header not on this list.
ALLOWED_HOSTS=tracker.wyreng.com

# Comma-separated, WITH scheme. Needed for the Django admin's CSRF check behind nginx.
CSRF_TRUSTED_ORIGINS=https://tracker.wyreng.com

# Where alert emails point people. Wrong value here and every link in every digest is dead.
APP_BASE_URL=https://tracker.wyreng.com

# App and API share one origin behind nginx, so this stays empty — no cross-origin requests to allow.
CORS_ALLOWED_ORIGINS=

# ── Uploads: DigitalOcean Spaces ────────────────────────────────────────────────
# Private bucket. Every download is a short-lived pre-signed URL; nothing is world-readable.
SPACES_BUCKET=projectstore
SPACES_REGION=lon1
SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=
SPACES_URL_EXPIRY=900

# ── Email: Mailgun ──────────────────────────────────────────────────────────────
# Sending key. Remember the API IP allowlist has to include this droplet's egress IP.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.wyreng.com
MAILGUN_FROM=Wyre Tracker <postmaster@mg.wyreng.com>

# ── Reading documents with Claude ───────────────────────────────────────────────
# Unset and the feature is inert: "Read file" returns a clear message instead of half-working.
# claude-opus-5 is $5/$25 per million tokens — a scanned permit is a fraction of a cent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Scheduler ───────────────────────────────────────────────────────────────────
ALERTS_INTERVAL_MINUTES=60
DIGEST_AT=07:30
# Leave 0 until real staff accounts exist. Flipping this to 1 with demo users on file emails strangers.
DIGEST_ENABLED=0
# Set to one address to route every digest there while testing. Unset = send to each real recipient.
DIGEST_TO=

# ── Frontend ────────────────────────────────────────────────────────────────────
# Relative on purpose: one origin, no CORS. Baked in at image build time, not read at runtime.
VITE_API_URL=/api/v1
WEB_PORT=8080
